// Generated by Quartus II Version 13.0.1 Build 232 06/12/2013 Service Pack 1 SJ Web Edition
// Created on Sat Aug 22 17:52:41 2026

// synthesis message_off 10175

`timescale 1ns/1ns

module STATE_MACHINE (
    reset,clock,beverage_selected,enough_credit,dispense_done,change_done,
    dispense_enable,change_enable);

    input reset;
    input clock;
    input beverage_selected;
    input enough_credit;
    input dispense_done;
    input change_done;
    tri0 reset;
    tri0 beverage_selected;
    tri0 enough_credit;
    tri0 dispense_done;
    tri0 change_done;
    output dispense_enable;
    output change_enable;
    reg dispense_enable;
    reg change_enable;
    reg [4:0] fstate;
    reg [4:0] reg_fstate;
    parameter IDLE=0,SEL=1,CREDIT=2,BEV=3,CHANGE=4;

    always @(posedge clock or posedge reset)
    begin
        if (reset) begin
            fstate <= IDLE;
        end
        else begin
            fstate <= reg_fstate;
        end
    end

    always @(fstate or beverage_selected or enough_credit or dispense_done or change_done)
    begin
        dispense_enable <= 1'b0;
        change_enable <= 1'b0;
        case (fstate)
            IDLE: begin
                if ((beverage_selected == 1'b1))
                    reg_fstate <= SEL;
                else if ((beverage_selected == 1'b0))
                    reg_fstate <= IDLE;
                // Inserting 'else' block to prevent latch inference
                else
                    reg_fstate <= IDLE;

                dispense_enable <= 1'b0;

                change_enable <= 1'b0;
            end
            SEL: begin
                reg_fstate <= CREDIT;

                dispense_enable <= 1'b0;

                change_enable <= 1'b0;
            end
            CREDIT: begin
                if ((enough_credit == 1'b1))
                    reg_fstate <= BEV;
                else if ((enough_credit == 1'b0))
                    reg_fstate <= CREDIT;
                // Inserting 'else' block to prevent latch inference
                else
                    reg_fstate <= CREDIT;

                dispense_enable <= 1'b0;

                change_enable <= 1'b0;
            end
            BEV: begin
                if ((dispense_done == 1'b1))
                    reg_fstate <= CHANGE;
                else if ((dispense_done == 1'b0))
                    reg_fstate <= BEV;
                // Inserting 'else' block to prevent latch inference
                else
                    reg_fstate <= BEV;

                dispense_enable <= 1'b1;

                change_enable <= 1'b0;
            end
            CHANGE: begin
                if ((change_done == 1'b1))
                    reg_fstate <= IDLE;
                else if ((change_done == 1'b0))
                    reg_fstate <= CHANGE;
                // Inserting 'else' block to prevent latch inference
                else
                    reg_fstate <= CHANGE;

                dispense_enable <= 1'b0;

                change_enable <= 1'b1;
            end
            default: begin
                dispense_enable <= 1'bx;
                change_enable <= 1'bx;
                $display ("Reach undefined state");
            end
        endcase
    end
endmodule // STATE_MACHINE
